# --- Models -------------------------------------------------------------------
# Default model for conversation.
NIKKI_MODEL=anthropic:claude-sonnet-5
# Stronger model for turns that touch the engineer toolchain (repo, deploy, build,
# Convex...). Leave empty to disable routing and run everything on NIKKI_MODEL.
NIKKI_ENGINEER_MODEL=anthropic:claude-opus-5
# Used only when the primary provider refuses for billing reasons. Must be a
# DIFFERENT provider than NIKKI_MODEL, or it fails on the same exhausted account.
NIKKI_FALLBACK_MODEL=openai:gpt-4.1

# --- Reasoning ----------------------------------------------------------------
# Extended thinking budget (Anthropic only). 0 disables it. Raises max_tokens when set.
NIKKI_THINKING_BUDGET_TOKENS=4000
# Answer budget for one model call.
NIKKI_MAX_TOKENS=8192
# Tool results from earlier turns are shortened to this many chars before being
# re-sent. 0 = off. Low values break the prompt cache and strip evidence.
NIKKI_OLD_TOOL_RESULT_CHARS=6000

# --- Keys and runtime ---------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DATABASE_URL=sqlite:///data/nikki.db
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
CHAINLIT_AUTH_SECRET=
ADMIN_API_TOKEN=
