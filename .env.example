# --- Models -------------------------------------------------------------------
# Default model for conversation.
NIKKI_MODEL=anthropic:claude-sonnet-5
# Model for turns that touch the engineer toolchain (repo, deploy, build, Convex...).
# Leave empty to disable routing and run everything on NIKKI_MODEL. Currently the same
# model as NIKKI_MODEL: routing stays exercised without adding cost. Raise it to an
# Opus-class model only as a deliberate, separately measured change.
NIKKI_ENGINEER_MODEL=anthropic:claude-sonnet-5
# Used only when the primary provider refuses for billing reasons. Must be a
# DIFFERENT provider than NIKKI_MODEL, or it fails on the same exhausted account.
NIKKI_FALLBACK_MODEL=openai:gpt-4.1

# --- Reasoning ----------------------------------------------------------------
# Extended thinking (Anthropic only). 0 disables it entirely; any value > 0 turns it on.
# On models that still take a fixed budget (Haiku 4.5, Sonnet 4.5) this IS the budget and
# raises max_tokens. On adaptive models (Sonnet 5, Opus 5, Opus 4.7+) the number is only an
# on/off switch - those models reject budget_tokens with a 400 - and depth comes from
# NIKKI_THINKING_EFFORT below.
NIKKI_THINKING_BUDGET_TOKENS=4000
# Depth for adaptive thinking: low | medium | high | xhigh | max. "high" is the API default,
# so "medium" is the setting that actually reduces spend.
NIKKI_THINKING_EFFORT=medium
# Answer budget for one model call.
NIKKI_MAX_TOKENS=8192
# Tool results from earlier turns are shortened to this many chars before being
# re-sent. 0 = off. Low values break the prompt cache and strip evidence.
NIKKI_OLD_TOOL_RESULT_CHARS=6000

# --- Keys and runtime ---------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DATABASE_URL=sqlite:///data/nikki.db
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
CHAINLIT_AUTH_SECRET=
ADMIN_API_TOKEN=
